%%metro title: cwbd-project
%%metro style: dark
%%metro line: light | Light index built from FASTA (default) | #0570b0
%%metro line: full | Full index with splice sites and exons (--hisat2_build_memory) | #2db572
%%metro line: prebuilt | Prebuilt HISAT2 index (--hisat2_index) | #f5a623
%%metro grid: qc_trim | 0,0
%%metro grid: align | 1,0
%%metro grid: markdup | 2,0
%%metro grid: bamqc | 3,0
%%metro grid: quantify | 2,1
%%metro grid: reporting | 1,1
%%metro file: reads_in | FASTQ
%%metro file: tpm_out | TSV | gene_tpm.tsv
%%metro file: counts_out | TSV | gene_counts.tsv
%%metro file: report_out | HTML | MultiQC report


graph LR
   subgraph qc_trim [QC and trimming]
        reads_in[ ]
        cat_fastq([cat fastq])
        fastqc([FastQC])
        fastp([fastp])

        reads_in -->|light,full,prebuilt| cat_fastq
        cat_fastq -->|light,full,prebuilt| fastqc
        fastqc -->|light,full,prebuilt| fastp
    end

    subgraph align [Alignment]
        extractsplicesites([HISAT2 extract splice sites])
        hisat2_build_light([HISAT2 build light])
        hisat2_build([HISAT2 build full])
        untar([untar])
        hisat2_align([HISAT2 align])
        samtools_sort([SAMtools sort])

        extractsplicesites -->|light| hisat2_build_light
        extractsplicesites -->|full| hisat2_build
        extractsplicesites -->|prebuilt| untar
        hisat2_build_light -->|light| hisat2_align
        hisat2_build -->|full| hisat2_align
        untar -->|prebuilt| hisat2_align
        hisat2_align -->|light,full,prebuilt| samtools_sort
    end

    subgraph markdup [Duplicate marking]
        picard([Picard MarkDuplicates])
    end

    subgraph bamqc [Alignment QC]
        %%metro direction: TB
        infer_experiment([RSeQC infer experiment])
        read_distribution([RSeQC read distribution])

        infer_experiment -->|light,full,prebuilt| read_distribution
    end

    subgraph quantify [Quantification]
        %%metro direction: RL
        stringtie([StringTie])
        merge_tpm([merge TPM])
        tpm_out[ ]
        featurecounts([featureCounts])
        merge_counts([merge counts])
        counts_out[ ]

        stringtie -->|light,full,prebuilt| merge_tpm
        merge_tpm -->|light,full,prebuilt| tpm_out
        featurecounts -->|light,full,prebuilt| merge_counts
        merge_counts -->|light,full,prebuilt| counts_out
    end

    subgraph reporting [Reporting]
        %%metro direction: RL
        multiqc([MultiQC])
        report_out[ ]
        multiqc -->|light,full,prebuilt| report_out
    end

    fastp -->|light,full,prebuilt| extractsplicesites
    samtools_sort -->|light,full,prebuilt| picard
    picard -->|light,full,prebuilt| infer_experiment
    read_distribution -->|light,full,prebuilt| featurecounts
    read_distribution -->|light,full,prebuilt| stringtie
    merge_counts -->|light,full,prebuilt| multiqc
