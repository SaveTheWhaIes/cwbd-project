%%metro title: cwbd-project
%%metro style: dark
%%metro line: build | Index built from FASTA and GTF (default) | #0570b0
%%metro line: prebuilt | Prebuilt HISAT2 index (--hisat2_index) | #f5a623
%%metro grid: qc_trim | 0,0
%%metro grid: align | 1,0
%%metro grid: markdup | 2,0
%%metro grid: bamqc | 2,1
%%metro grid: quantify | 1,1
%%metro grid: reporting | 0,1
%%metro file: reads_in | FASTQ
%%metro file: tpm_out | TSV | gene_tpm.tsv
%%metro file: counts_out | TSV | gene_counts.tsv
%%metro file: report_out | HTML | MultiQC report


graph LR
   subgraph qc_trim [QC and trimming]
        reads_in[ ]
        cat_fastq([cat fastq])
        fastqc([FastQC])
        fastp([fastp])

        reads_in -->|build,prebuilt| cat_fastq
        cat_fastq -->|build,prebuilt| fastqc
        fastqc -->|build,prebuilt| fastp
    end

    subgraph align [Alignment]
        extractsplicesites([HISAT2 extract splice sites])
        hisat2_build([HISAT2 build])
        untar([untar])
        hisat2_align([HISAT2 align])
        samtools_sort([SAMtools sort])

        extractsplicesites -->|build| hisat2_build
        extractsplicesites -->|prebuilt| untar
        hisat2_build -->|build| hisat2_align
        untar -->|prebuilt| hisat2_align
        hisat2_align -->|build,prebuilt| samtools_sort
    end

    subgraph markdup [Duplicate marking]
        picard([Picard MarkDuplicates])
    end

    subgraph bamqc [Alignment QC]
        %%metro direction: RL
        infer_experiment([RSeQC infer experiment])
        read_distribution([RSeQC read distribution])

        infer_experiment -->|build,prebuilt| read_distribution
    end

    subgraph quantify [Quantification]
        %%metro direction: RL
        stringtie([StringTie])
        merge_tpm([merge TPM])
        tpm_out[ ]
        featurecounts([featureCounts])
        merge_counts([merge counts])
        counts_out[ ]

        stringtie -->|build,prebuilt| merge_tpm
        merge_tpm -->|build,prebuilt| tpm_out
        featurecounts -->|build,prebuilt| merge_counts
        merge_counts -->|build,prebuilt| counts_out
    end

    subgraph reporting [Reporting]
        %%metro direction: RL
        multiqc([MultiQC])
        report_out[ ]
        multiqc -->|build,prebuilt| report_out
    end

    fastp -->|build,prebuilt| extractsplicesites
    samtools_sort -->|build,prebuilt| picard
    picard -->|build,prebuilt| infer_experiment
    read_distribution -->|build,prebuilt| featurecounts
    read_distribution -->|build,prebuilt| stringtie
    merge_counts -->|build,prebuilt| multiqc
