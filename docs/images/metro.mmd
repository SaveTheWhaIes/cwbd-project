%%metro title: cwbd-project
%%metro style: dark
%%metro line: tpm | Reads to gene TPM | #0570b0
%%metro line: counts | Reads to gene counts and MultiQC report | #2db572
%%metro line: ref | Reference and index build | #f5a623
%%metro line: prebuilt | Prebuilt index | #9b59b6
%%metro grid: qc_trim | 0,0
%%metro grid: align | 1,0
%%metro grid: markdup | 2,0
%%metro grid: quantify | 3,0
%%metro grid: reporting | 4,1
%%metro file: reads_in | FASTQ
%%metro file: fasta_in | FASTA
%%metro file: gtf_in | GTF
%%metro dir: index_in | HISAT2 index
%%metro file: gtf_quant | GTF
%%metro file: tpm_out | TSV | gene_tpm.tsv
%%metro file: counts_out | TSV | gene_counts.tsv
%%metro file: report_out | HTML | MultiQC report


graph LR
   subgraph qc_trim [QC and trimming]
        reads_in[ ]
        cat_fastq([cat fastq])
        fastqc([FastQC])
        fastp([fastp])

        reads_in -->|tpm,counts| cat_fastq
        cat_fastq -->|tpm,counts| fastqc
        fastqc -->|tpm,counts| fastp
    end

    subgraph align [Alignment]
        gtf_in[ ]
        fasta_in[ ]
        index_in[ ]
        extractsplicesites([HISAT2 extract splice sites])
        hisat2_build([HISAT2 build])
        untar([untar])
        hisat2_align([HISAT2 align])
        samtools_sort([SAMtools sort])

        extractsplicesites -->|ref| hisat2_build
        extractsplicesites -->|ref| hisat2_align
        hisat2_build -->|ref| hisat2_align
        untar -->|prebuilt| hisat2_align
        hisat2_align -->|tpm,counts| samtools_sort
        index_in -->|prebuilt| untar
        fasta_in -->|ref| hisat2_build
        gtf_in -->|ref| extractsplicesites
    end

    subgraph markdup [Duplicate marking]
        picard([Picard MarkDuplicates])
    end

    subgraph quantify [Quantification]
        gtf_quant[ ]
        stringtie([StringTie])
        merge_tpm([merge TPM])
        tpm_out[ ]
        featurecounts([featureCounts])
        merge_counts([merge counts])
        counts_out[ ]

        gtf_quant -->|ref| stringtie
        gtf_quant -->|ref| featurecounts
        stringtie -->|tpm| merge_tpm
        merge_tpm -->|tpm| tpm_out
        featurecounts -->|counts| merge_counts
        merge_counts -->|counts| counts_out
    end

    subgraph reporting [Reporting]
        multiqc([MultiQC])
        report_out[ ]
        multiqc -->|counts| report_out
    end

    fastp -->|tpm,counts| hisat2_align
    samtools_sort -->|tpm,counts| picard
    picard -->|tpm| stringtie
    picard -->|counts| featurecounts
    merge_counts -->|counts| multiqc
