nextflow_pipeline {

    name "Test pipeline with a full HISAT2 index"
    script "../main.nf"
    tag "pipeline"

    test("-profile test, full index") {

        when {
            params {
                outdir              = "$outputDir"
                hisat2_build_memory = '1.GB'
            }
        }

        then {
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}'])
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assert workflow.success
            assertAll(
                { assert workflow.trace.succeeded().count { task -> task.name.contains('HISAT2_BUILD') } == 1 },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/cwbdproject_software_mqc_versions.yml"),
                    stable_path,
                    stable_content
                ).match() }
            )
        }
    }
}